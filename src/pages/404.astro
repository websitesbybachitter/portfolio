---
import Button from '@/components/Button.astro';
import Layout from '@/layouts/Layout.astro';
import { siteConfig } from '@/config';
---

<Layout title="Page not found" description="The page you're looking for doesn't exist.">
	<main class="mx-auto flex w-full max-w-5xl min-h-dvh flex-col justify-center px-8 pb-24 pt-16 lg:pt-24">
		<header class="flex animate-fade-up max-w-xl flex-col gap-4">
			<h1 class="font-display text-4xl font-medium md:text-5xl">
				Page not found<span class="text-accent">.</span>
			</h1>
			<p class="leading-relaxed text-muted">
				The page you're looking for doesn't exist — it may have moved or
				never been here.
			</p>

			<div class="mt-2 flex flex-wrap gap-3">
				<Button href="/">Back home</Button>
				<Button href={siteConfig.mailtoHref} variant="secondary">
					Email me
				</Button>
			</div>
		</header>
	</main>
</Layout>