---
import Button from '@/components/Button.astro';
import HoverableText from '@/components/HoverableText.astro';
import Layout from '@/layouts/Layout.astro';
import { siteConfig } from '@/config';

const hoverPhotos = siteConfig.hoverPhotos;

const faq = [
  {
    question: 'How long does it take?',
    answer:
      "Somewhere between two and six weeks, depending on how much we're building. You'll get a firm deadline before we start, and I'll keep it.",
  },
  {
    question: 'Is there support after launch?',
    answer:
      "Yes. Once the site is live you're not on your own. I'm around for questions and fixes, and if you want regular changes there are maintenance plans from $49 a month, depending on how much editing you need.",
  },
  {
    question: 'What do you build with?',
    answer:
      'Astro. It ships as static files, so the site loads fast and stays fast, and the code is simple enough that you can host it anywhere. The site stays yours.',
  },
  {
    question: 'How do we get started?',
    answer:
      "Once we agree on scope and price, you pay 50% upfront and the rest when it's done. We work over WhatsApp, Telegram, or email. It takes a few days before there's something to look at; we go through it together and refine until it's right.",
  },
] as const;
---

<Layout>
	<main class="mx-auto w-full max-w-5xl overflow-x-clip px-8 pb-24 pt-16 lg:pt-24">
		<header class="mb-16 flex animate-fade-up justify-end">
			<nav class="flex items-center gap-6 text-sm">
				<a
					href="#work"
					class="text-muted transition-colors duration-150 hover:text-accent"
				>
					Work
				</a>
				<a
					href="#pricing"
					class="text-muted transition-colors duration-150 hover:text-accent"
				>
					Pricing
				</a>
				<a
					href={siteConfig.mailtoHref}
					class="text-muted transition-colors duration-150 hover:text-accent"
				>
					Email
				</a>
			</nav>
		</header>

		<div class="lg:grid lg:grid-cols-12 lg:gap-16">
			<aside class="mb-16 flex flex-col gap-8 lg:sticky lg:top-16 lg:mb-0 lg:col-span-4 lg:self-start lg:gap-12">
				<header class="flex animate-fade-up flex-col gap-4">
					<h1 class="font-display text-4xl font-medium md:text-5xl">
						{siteConfig.name}
						<span class="text-accent">.</span>
					</h1>
					<p class="flex flex-wrap items-center gap-x-2 text-sm text-muted">
						Web designer and developer
						<span aria-hidden="true">·</span>
						India
					</p>

					<div class="flex flex-wrap gap-3">
						<Button href={siteConfig.mailtoHref}>
							Email me
						</Button>
						<Button href={siteConfig.bookCallHref} variant="secondary">
							Book a call
						</Button>
					</div>
				</header>
			</aside>

			<div class="flex flex-col gap-16 lg:col-span-8">
<section class="flex max-w-xl animate-fade-up flex-col gap-6 leading-relaxed text-muted [animation-delay:160ms]">
				{
					siteConfig.introParagraphs.map((paragraph) => (
						<HoverableText text={paragraph} photos={hoverPhotos} />
					))
				}
			</section>

				<section id="work" class="animate-fade-up [animation-delay:300ms]">
					<h2 class="font-display text-2xl italic">Work</h2>

					<ol class="mt-6 border-t border-border">
						{
							siteConfig.pastClients.slice(0, 6).map(({ name, url }, index) => (
								<li class="border-b border-border">
									<a
										href={url}
									rel="noopener noreferrer nofollow"
									target="_blank"
										class="group flex items-baseline gap-6 px-2 py-4 transition-colors duration-150 hover:bg-black/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
									>
										<span class="w-7 shrink-0 text-xs tabular-nums text-muted transition-colors duration-150 group-hover:text-accent">
											{String(index + 1).padStart(2, '0')}
										</span>
										<span class="flex-1 transition-colors duration-150 group-hover:text-accent">
											{name}
										</span>
										<svg
											viewBox="0 0 24 24"
											fill="currentColor"
											aria-hidden="true"
											class="size-4 shrink-0 -translate-x-1 text-accent opacity-0 transition-all duration-150 group-hover:translate-x-0 group-hover:opacity-100"
										>
											<path d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5h-1.5v8.25a.75.75 0 0 1-.75.75H5.25a.75.75 0 0 1-.75-.75V8.25a.75.75 0 0 1 .75-.75H13.5V6Z" />
											<path d="M15 3.75a.75.75 0 0 1 .75-.75h4.5a.75.75 0 0 1 .75.75v4.5a.75.75 0 0 1-1.5 0V5.56l-4.72 4.72a.75.75 0 1 1-1.06-1.06l4.72-4.72h-2.69a.75.75 0 0 1-.75-.75Z" />
										</svg>
									</a>
								</li>
							))
						}
						<li class="border-b border-border">
							<a
								href={siteConfig.bookCallHref}
								class="group flex items-baseline gap-6 px-2 py-4 transition-colors duration-150 hover:bg-black/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
							>
								<span class="w-7 shrink-0 text-accent">
									<svg
										viewBox="0 0 24 24"
										fill="currentColor"
										aria-hidden="true"
										class="size-4"
									>
										<path d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5h-1.5v8.25a.75.75 0 0 1-.75.75H5.25a.75.75 0 0 1-.75-.75V8.25a.75.75 0 0 1 .75-.75H13.5V6Z" />
										<path d="M15 3.75a.75.75 0 0 1 .75-.75h4.5a.75.75 0 0 1 .75.75v4.5a.75.75 0 0 1-1.5 0V5.56l-4.72 4.72a.75.75 0 1 1-1.06-1.06l4.72-4.72h-2.69a.75.75 0 0 1-.75-.75Z" />
									</svg>
								</span>
								<span class="flex-1 text-muted transition-colors duration-150 group-hover:text-accent">
									Your project
								</span>
								<span class="flex shrink-0 items-center gap-1.5 text-sm text-accent">
									Next
									<svg
										viewBox="0 0 24 24"
										fill="currentColor"
										aria-hidden="true"
										class="size-4 shrink-0 transition-transform duration-150 group-hover:translate-x-0.5"
									>
										<path d="M13.5 4.5 21 12l-7.5 7.5V15H3v-6h10.5V4.5Z" />
									</svg>
								</span>
							</a>
						</li>
					</ol>
				</section>

				<section id="pricing" class="animate-fade-up [animation-delay:500ms]">
					<h2 class="font-display text-2xl italic">Pricing</h2>

					<ul class="mt-6 border-t border-border">
						<li class="border-b border-border py-6">
							<div class="flex items-baseline justify-between gap-6">
								<div class="flex items-baseline gap-6">
									<span class="w-7 shrink-0 text-xs tabular-nums text-muted">01</span>
									<h3 class="text-base font-semibold">Starter</h3>
								</div>
								<p class="shrink-0 text-sm text-accent">CAD 599</p>
							</div>
							<p class="mt-3 max-w-xl pl-[3.25rem] leading-relaxed text-muted">
								For a simple online presence or a focused landing page.
							</p>
							<ul class="mt-3 space-y-1.5 pl-[3.25rem]">
								<li class="flex gap-2 text-sm text-muted">
									<span aria-hidden="true">·</span>
									<span>One-page website</span>
								</li>
								<li class="flex gap-2 text-sm text-muted">
									<span aria-hidden="true">·</span>
									<span>Responsive design</span>
								</li>
								<li class="flex gap-2 text-sm text-muted">
									<span aria-hidden="true">·</span>
									<span>Contact form</span>
								</li>
								<li class="flex gap-2 text-sm text-muted">
									<span aria-hidden="true">·</span>
									<span>Basic SEO</span>
								</li>
							</ul>
						</li>

						<li class="border-b border-border py-6">
							<div class="flex items-baseline justify-between gap-6">
								<div class="flex items-baseline gap-6">
									<span class="w-7 shrink-0 text-xs tabular-nums text-muted">02</span>
									<h3 class="text-base font-semibold">Business</h3>
								</div>
								<p class="shrink-0 text-sm text-accent">CAD 1,499</p>
							</div>
							<p class="mt-3 max-w-xl pl-[3.25rem] leading-relaxed text-muted">
								For contractors and service businesses.
							</p>
							<ul class="mt-3 space-y-1.5 pl-[3.25rem]">
								<li class="flex gap-2 text-sm text-muted">
									<span aria-hidden="true">·</span>
									<span>Multi-page website</span>
								</li>
								<li class="flex gap-2 text-sm text-muted">
									<span aria-hidden="true">·</span>
									<span>Service pages</span>
								</li>
								<li class="flex gap-2 text-sm text-muted">
									<span aria-hidden="true">·</span>
									<span>Portfolio</span>
								</li>
								<li class="flex gap-2 text-sm text-muted">
									<span aria-hidden="true">·</span>
									<span>Testimonials</span>
								</li>
								<li class="flex gap-2 text-sm text-muted">
									<span aria-hidden="true">·</span>
									<span>Contact or quote form</span>
								</li>
								<li class="flex gap-2 text-sm text-muted">
									<span aria-hidden="true">·</span>
									<span>Basic SEO</span>
								</li>
								<li class="flex gap-2 text-sm text-muted">
									<span aria-hidden="true">·</span>
									<span>Analytics and launch setup</span>
								</li>
							</ul>
						</li>

						<li class="border-b border-border py-6">
							<div class="flex items-baseline justify-between gap-6">
								<div class="flex items-baseline gap-6">
									<span class="w-7 shrink-0 text-xs tabular-nums text-muted">03</span>
									<h3 class="text-base font-semibold">Growth</h3>
								</div>
								<p class="shrink-0 text-sm text-accent">CAD 2,499+</p>
							</div>
							<p class="mt-3 max-w-xl pl-[3.25rem] leading-relaxed text-muted">
								For larger websites and custom requirements.
							</p>
							<ul class="mt-3 space-y-1.5 pl-[3.25rem]">
								<li class="flex gap-2 text-sm text-muted">
									<span aria-hidden="true">·</span>
									<span>More pages</span>
								</li>
								<li class="flex gap-2 text-sm text-muted">
									<span aria-hidden="true">·</span>
									<span>Advanced functionality</span>
								</li>
								<li class="flex gap-2 text-sm text-muted">
									<span aria-hidden="true">·</span>
									<span>Custom integrations</span>
								</li>
								<li class="flex gap-2 text-sm text-muted">
									<span aria-hidden="true">·</span>
									<span>Advanced CMS</span>
								</li>
								<li class="flex gap-2 text-sm text-muted">
									<span aria-hidden="true">·</span>
									<span>Custom features</span>
								</li>
							</ul>
						</li>
					</ul>
				</section>

				<section id="faq" class="animate-fade-up [animation-delay:600ms]">
					<h2 class="font-display text-2xl italic">Questions</h2>

					<div class="mt-6 border-t border-border">
						{
							faq.map((item, index) => (
								<details class="group border-b border-border">
									<summary class="flex cursor-pointer list-none items-baseline gap-6 py-5 select-none transition-colors duration-150 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent [&::-webkit-details-marker]:hidden marker:hidden">
										<span class="w-7 shrink-0 text-xs tabular-nums text-muted">
											{String(index + 1).padStart(2, '0')}
										</span>
										<span class="flex-1 text-base font-medium">{item.question}</span>
										<span
											aria-hidden="true"
											class="shrink-0 text-accent transition-transform duration-200 group-open:rotate-45"
										>
											+
										</span>
									</summary>
									<p class="max-w-xl pb-6 pl-[3.25rem] leading-relaxed text-muted">
										{item.answer}
									</p>
								</details>
							))
						}
					</div>
				</section>

				<script
					is:inline
					type="application/ld+json"
					set:html={JSON.stringify({
						'@context': 'https://schema.org',
						'@type': 'FAQPage',
						mainEntity: faq.map(({ question, answer }) => ({
							'@type': 'Question',
							name: question,
							acceptedAnswer: { '@type': 'Answer', text: answer },
						})),
					})}
				/>

				<section class="animate-fade-up [animation-delay:700ms]">
					<p class="leading-relaxed">
						Need something different?{' '}
						<a
							href={siteConfig.bookCallHref}
							class="decoration-accent decoration-1 underline underline-offset-4 transition-colors duration-150 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
						>
							Let's talk.
						</a>
					</p>
				</section>
			</div>
		</div>
	</main>

	<footer class="animate-fade-up border-t border-border [animation-delay:700ms]">
		<div class="mx-auto flex w-full max-w-5xl justify-end p-8 pb-14">
			<p class="flex select-none items-center gap-1.5 text-xs tabular-nums text-muted">
				<span class="grid size-6 place-items-center" aria-hidden="true">
					<svg viewBox="0 0 24 24" class="size-6">
						<circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1" />
						<line id="clock-hour" x1="12" y1="12" x2="12" y2="7" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" style="transform-box: fill-box; transform-origin: 50% 100%;" />
						<line id="clock-minute" x1="12" y1="12" x2="12" y2="5.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" style="transform-box: fill-box; transform-origin: 50% 100%;" />
						<line id="clock-second" x1="12" y1="12" x2="12" y2="4.5" stroke="currentColor" stroke-width="0.6" stroke-linecap="round" class="text-accent" style="transform-box: fill-box; transform-origin: 50% 100%;" />
						<circle cx="12" cy="12" r="0.9" fill="currentColor" />
					</svg>
				</span>
				<span id="local-time">--:--</span>
				<span id="local-timezone"></span>
			</p>
		</div>
	</footer>
</Layout>

<script>
	const timeElement = document.getElementById('local-time');
	const timezoneElement = document.getElementById('local-timezone');
	const hourHand = document.getElementById('clock-hour');
	const minuteHand = document.getElementById('clock-minute');
	const secondHand = document.getElementById('clock-second');
	const faqItems = document.querySelectorAll('#faq details');

	const timeZone = 'Asia/Kolkata';
	const timezoneLabel = 'IST';

	const nowInTimeZone = () => new Date(Date.now() + 330 * 60_000);

	const formatTime = (time) =>
		new Intl.DateTimeFormat('en-GB', {
			timeZone: 'UTC',
			hour: '2-digit',
			minute: '2-digit',
			hour12: false,
		}).format(time);

	const rotateHands = (time) => {
		const hours = time.getUTCHours() % 12;
		const minutes = time.getUTCMinutes();
		const seconds = time.getUTCSeconds() + time.getMilliseconds() / 1000;

		if (hourHand) {
			hourHand.style.transform = `rotate(${(hours + minutes / 60) * 30}deg)`;
		}
		if (minuteHand) {
			minuteHand.style.transform = `rotate(${(minutes + seconds / 60) * 6}deg)`;
		}
		if (secondHand) {
			secondHand.style.transform = `rotate(${seconds * 6}deg)`;
		}
	};

	const tick = () => {
		const time = nowInTimeZone();
		const formattedTime = formatTime(time);

		if (timeElement?.textContent !== formattedTime) {
			timeElement.textContent = formattedTime;
		}
		if (timezoneElement?.textContent !== ` ${timezoneLabel}`) {
			timezoneElement.textContent = ` ${timezoneLabel}`;
		}
		rotateHands(time);
	};

	const frame = () => {
		tick();
		requestAnimationFrame(frame);
	};

	faqItems.forEach((item) => {
		item.addEventListener('toggle', () => {
			if (item.open) {
				faqItems.forEach((other) => {
					if (other !== item) {
						other.open = false;
					}
				});
			}
		});
	});

	frame();
</script>