---
import { Font } from 'astro:assets';
import { SEO } from 'astro-seo';
import { contact, seo } from '@/config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = seo.title, description = seo.description } = Astro.props;

const siteUrl = Astro.site ?? new URL(seo.siteUrl);
const siteUrlString = siteUrl.toString().replace(/\/$/, '');
const ogImage = new URL('/og.png', siteUrl).toString();
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<Font cssVariable="--font-instrument-sans" />
		<Font cssVariable="--font-fraunces" />
		<Font cssVariable="--font-noto-gurmukhi" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f7f5f0" />
		<meta name="keywords" content={seo.keywords.join(', ')} />
		<SEO
			title={title}
			description={description}
			removeTrailingSlashForRoot
			openGraph={{
				basic: {
					title,
					type: 'website',
					image: ogImage,
					url: siteUrlString,
				},
				image: {
					url: ogImage,
					width: 1200,
					height: 630,
					type: 'image/png',
					alt: `${contact.name} — Web designer and developer`,
				},
				optional: {
					description,
					locale: 'en_CA',
					siteName: contact.name,
				},
			}}
			twitter={{
				card: 'summary_large_image',
				title,
				description,
				image: ogImage,
			}}
		/>
		<script
			is:inline
			type="application/ld+json"
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@graph': [
					{
						'@type': 'Person',
						'@id': `${siteUrlString}/#person`,
						name: contact.name,
						url: siteUrlString,
						jobTitle: 'Web designer and developer',
						email: `mailto:${contact.email}`,
					},
					{
						'@type': 'WebSite',
						'@id': `${siteUrlString}/#website`,
						url: siteUrlString,
						name: contact.name,
						description,
						inLanguage: 'en',
						publisher: { '@id': `${siteUrlString}/#person` },
					},
				],
			})}
		/>
	</head>

	<body class="bg-background text-[15px] text-foreground antialiased">
		<slot />
	</body>
</html>

<script>
	document.querySelectorAll('.animate-fade-up').forEach((element) => {
		element.addEventListener(
			'animationend',
			() => {
				element.style.animation = 'none';
			},
			{ once: true },
		);
	});
</script>