---
import { getImage, type ImageMetadata } from 'astro:assets';

interface HoverPhoto {
  src: string | ImageMetadata;
  alt: string;
}

interface OptimizedHoverPhoto {
  src: string;
  alt: string;
}

interface Photo {
  word: string;
  photos: HoverPhoto[];
}

interface Props {
  text: string;
  photos: Photo[];
  class?: string;
}

const { text, photos, class: classProp = '' } = Astro.props;

const positions = [
  'z-10 -rotate-12 hover:z-40',
  'z-20 -ml-2 rotate-2 hover:z-40',
  'z-30 -ml-2 rotate-12 hover:z-40',
];

const optimizedPhotos = await Promise.all(
  photos.map(async (photo) => ({
    word: photo.word,
    photos: await Promise.all(
      photo.photos.map(async (image): Promise<OptimizedHoverPhoto> => {
        if (typeof image.src === 'string') {
          return {
            src: image.src,
            alt: image.alt,
          };
        }

        const optimizedImage = await getImage({
          src: image.src,
          width: 388,
        });

        return {
          src: optimizedImage.src,
          alt: image.alt,
        };
      }),
    ),
  })),
);

const wordsWithPhotos = optimizedPhotos.filter((photo) => photo.photos.length > 0);

const escapeRegExp = (value: string) => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

const pattern = new RegExp(
  `(${wordsWithPhotos.map((photo) => escapeRegExp(photo.word)).join('|')})`,
  'gi',
);
const parts = text.split(pattern).filter((part) => part !== '');
---

<p class={classProp}>
  {
    parts.map((part) => {
      const photo = wordsWithPhotos.find(
        (candidate) => candidate.word.toLowerCase() === part.toLowerCase(),
      );

      return photo ? (
        <span
          class={`hover-photos relative cursor-help whitespace-nowrap underline decoration-dotted decoration-1 underline-offset-4 transition-colors duration-150 hover:text-accent group`}
        >
          {part}
          <span
            data-popover
            class="pointer-events-none invisible absolute z-50 flex items-end opacity-0 transition-all duration-200 group-hover:visible group-hover:opacity-100"
          >
            {
              photo.photos.map((image, index) => (
                <img
                  src={image.src}
                  alt={image.alt}
                  loading="lazy"
                  class={`aspect-[3/4] w-36 shrink-0 rounded-lg border-4 border-white object-cover object-center ring-1 ring-border shadow-[0_8px_24px_rgba(17,17,17,0.16)] transition-all duration-200 ${positions[index] ?? ''}`}
                />
              ))
            }
          </span>
        </span>
      ) : (
        <span key={part}>{part}</span>
      );
    })
  }
</p>

<script>
	const GAP = 12;
	const EDGE_MARGIN = 8;

	const getClipContainer = (element) => {
		let current = element.parentElement;
		while (current && current !== document.body) {
			const overflowX = getComputedStyle(current).overflowX;
			if (['clip', 'hidden', 'auto', 'scroll'].includes(overflowX)) {
				return current;
			}
			current = current.parentElement;
		}
		return document.documentElement;
	};

	const isTouchDevice =
		'ontouchstart' in window || navigator.maxTouchPoints > 0;
	const isHoverCapable =
		window.matchMedia('(hover: hover)').matches && !isTouchDevice;
	const randomTilt = () => (Math.random() * 2 - 1) * 10;
	const isPhoneView = () => window.innerWidth < 768;
	const applyImageTilts = (popover) => {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			return;
		}
		popover.querySelectorAll('img').forEach((img) => {
			const tilt = randomTilt();
			img.dataset.tilt = String(tilt);
			img.style.transformOrigin = '50% 100%';
			img.style.transform = `rotate(${tilt}deg)`;
		});
	};

	document.addEventListener(
		'pointerenter',
		(event) => {
			if (!isHoverCapable) {
				return;
			}

			const word = event.target?.closest?.('.hover-photos');
			const popover = word?.querySelector('[data-popover]');
			if (!word || !popover) {
				return;
			}

			const wordRect = word.getBoundingClientRect();
			const container = getClipContainer(word);
			const containerRect = container.getBoundingClientRect();
			const popoverWidth = popover.offsetWidth;
			const popoverHeight = popover.offsetHeight;

			const fitsBelow =
				wordRect.bottom + popoverHeight + GAP <=
				containerRect.bottom - EDGE_MARGIN;
			const fitsAbove =
				wordRect.top - popoverHeight - GAP >=
				containerRect.top + EDGE_MARGIN;

			if (fitsBelow && !fitsAbove) {
				popover.style.top = `${GAP}px`;
				popover.style.removeProperty('bottom');
			} else {
				popover.style.bottom = `${wordRect.height + GAP}px`;
				popover.style.removeProperty('top');
			}

			const center = wordRect.left + wordRect.width / 2;
			const minLeft = containerRect.left + EDGE_MARGIN;
			const maxLeft = containerRect.right - popoverWidth - EDGE_MARGIN;
			const desiredLeft = center - popoverWidth / 2;
			const clampedLeft = Math.min(Math.max(desiredLeft, minLeft), maxLeft);

			popover.style.left = `${clampedLeft - wordRect.left}px`;

			if (isPhoneView()) {
				applyImageTilts(popover);
			}
		},
		true,
	);

	if (!isHoverCapable) {
		const tapWords = document.querySelectorAll('.hover-photos');
		let openPopover = null;
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	const neutralizeAncestors = (element) => {
		let current = element.parentElement;
		while (current) {
			if (getComputedStyle(current).animationName !== 'none') {
				current.style.animation = 'none';
			}
			current = current.parentElement;
		}
	};

	const getTransformOrigin = (popover, wordRect, isAbove) => {
		const popoverLeft = parseFloat(popover.style.left) || 0;
		const popoverHeight = popover.offsetHeight;
		const popoverWidth = popover.offsetWidth;
		const wordCenterX = wordRect.left + wordRect.width / 2;
		const originX = Math.min(
			Math.max(wordCenterX - popoverLeft, 0),
			popoverWidth,
		);
		return `${originX}px ${isAbove ? popoverHeight : 0}px`;
	};

	const hidePopover = (popover) => {
		if (!popover) {
			return;
		}
		popover.style.zIndex = '';
		const word = popover.closest('.hover-photos');
		if (word) {
			word.style.zIndex = '';
		}
		if (reduceMotion) {
			popover.style.visibility = 'hidden';
			popover.style.opacity = '0';
			return;
		}
		const wordRect = word.getBoundingClientRect();
		const popoverRect = popover.getBoundingClientRect();
		popover.style.transformOrigin = getTransformOrigin(
			popover,
			wordRect,
			popoverRect.top < wordRect.top,
		);
		popover.style.transitionDuration = '200ms';
		popover.style.transform = 'scale(0.6)';
		popover.style.opacity = '0';
		popover.style.visibility = 'hidden';
	};

	const showPopover = (popover, wordRect, side) => {
		popover.style.transformOrigin = getTransformOrigin(
			popover,
			wordRect,
			side === 'above',
		);

		popover.style.visibility = 'visible';
		if (reduceMotion) {
			popover.style.opacity = '1';
			return;
		}
		popover.style.transitionDuration = '200ms';
		popover.classList.add('popover-no-anim');
		applyImageTilts(popover);
		popover.style.transform = 'scale(0.6)';
		popover.style.opacity = '0';
		void popover.offsetWidth;
		popover.classList.remove('popover-no-anim');
		popover.style.transform = 'scale(1)';
		popover.style.opacity = '1';
	};

	const positionFixed = (popover, wordRect) => {
		const viewportWidth = window.innerWidth;
		const viewportHeight = window.innerHeight;
		const maxWidth = viewportWidth - 2 * EDGE_MARGIN;

		popover.style.maxWidth = `${maxWidth}px`;
		popover.style.flexWrap = 'wrap';
		popover.style.position = 'fixed';
		popover.style.zIndex = '9999';
		popover.style.removeProperty('maxHeight');
		popover.style.removeProperty('overflowY');

		const word = popover.closest('.hover-photos');
		if (word) {
			word.style.zIndex = '9999';
		}

		let popoverWidth = popover.offsetWidth;
		let popoverHeight = popover.offsetHeight;
		const usableHeight = viewportHeight - 2 * EDGE_MARGIN;
		if (popoverHeight > usableHeight) {
			popover.style.maxHeight = `${usableHeight}px`;
			popover.style.overflowY = 'auto';
			popoverHeight = usableHeight;
		}

		let top;
		let side;
		const roomAbove = wordRect.top - EDGE_MARGIN;
		const roomBelow = viewportHeight - EDGE_MARGIN - wordRect.bottom;
		const fitsAbove = roomAbove >= popoverHeight + GAP;
		const fitsBelow = roomBelow >= popoverHeight + GAP;

		if (fitsAbove && (!fitsBelow || roomAbove >= roomBelow)) {
			top = wordRect.top - popoverHeight - GAP;
			side = 'above';
		} else if (fitsBelow) {
			top = wordRect.bottom + GAP;
			side = 'below';
		} else if (roomAbove >= roomBelow) {
			top = Math.max(EDGE_MARGIN, wordRect.top - popoverHeight - GAP);
			side = 'above';
		} else {
			top = Math.max(
				EDGE_MARGIN,
				Math.min(wordRect.bottom + GAP, viewportHeight - popoverHeight - EDGE_MARGIN),
			);
			side = 'below';
		}

		const centeredLeft = wordRect.left + wordRect.width / 2 - popoverWidth / 2;
		const left = Math.min(
			Math.max(centeredLeft, EDGE_MARGIN),
			Math.max(EDGE_MARGIN, viewportWidth - popoverWidth - EDGE_MARGIN),
		);

		popover.style.top = `${top}px`;
		popover.style.left = `${left}px`;
		popover.style.removeProperty('bottom');
		return side;
	};

	tapWords.forEach((word) => {
		word.addEventListener('click', () => {
			const popover = word.querySelector('[data-popover]');
			if (!popover) {
				return;
			}

			const isOpening = openPopover !== popover;
			hidePopover(openPopover);
			openPopover = null;

			if (isOpening) {
				neutralizeAncestors(word);
				const wordRect = word.getBoundingClientRect();
				const side = positionFixed(popover, wordRect);
				showPopover(popover, wordRect, side);
				openPopover = popover;
			}
		});
	});

	document.addEventListener(
		'click',
		(event) => {
			if (openPopover && !event.target.closest('.hover-photos')) {
				hidePopover(openPopover);
				openPopover = null;
			}
		},
		true,
	);

	window.addEventListener(
		'scroll',
		(event) => {
			if (!openPopover) {
				return;
			}
			if (event.target instanceof Element && openPopover.contains(event.target)) {
				return;
			}
			hidePopover(openPopover);
			openPopover = null;
		},
		true,
	);
	}
</script>

<style>
	[data-popover] {
		transition-property: transform, opacity, visibility;
		transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
		transition-behavior: allow-discrete;
	}

	.popover-no-anim {
		transition: none !important;
	}
</style>
