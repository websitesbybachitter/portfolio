---
interface Props {
  href?: string;
  type?: 'button' | 'submit';
  rel?: string;
  target?: string;
  variant?: 'primary' | 'secondary' | 'inverse' | 'ghost';
  class?: string;
}

const { href, type = 'button', rel, target, variant = 'primary', class: classProp = '' } =
  Astro.props;

const baseClass =
  'inline-flex items-center justify-center gap-x-2 rounded-lg px-[calc(--spacing(3)-1px)] py-[calc(--spacing(2)-1px)] text-sm font-semibold transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';

const primaryClass =
  'relative isolate border border-transparent bg-(--btn-border) text-inverse before:absolute before:inset-0 before:-z-10 before:rounded-[calc(var(--radius-lg)-1px)] before:bg-(--btn-bg) [--btn-bg:var(--color-brand)] [--btn-border:var(--color-brand)] hover:[--btn-bg:var(--color-brand-hover)] active:[--btn-bg:var(--color-brand-active)]';

const secondaryClass =
  'border border-border bg-transparent text-foreground hover:bg-surface-subtle';

const inverseClass =
  'border border-transparent bg-surface text-brand hover:bg-brand-subtle';

const ghostClass =
  'border border-border-dark bg-transparent text-inverse hover:bg-white/10';

const variantClass =
  variant === 'secondary'
    ? secondaryClass
    : variant === 'inverse'
      ? inverseClass
      : variant === 'ghost'
        ? ghostClass
        : primaryClass;

const className = `${baseClass} ${variantClass} ${classProp}`;
---

{
	href ? (
		<a href={href} rel={rel} target={target} class={`${className} cursor-pointer`}>
			<slot />
		</a>
	) : (
		<button type={type} class={`${className} cursor-default`}>
			<slot />
		</button>
	)
}
