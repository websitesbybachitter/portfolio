---
interface Props {
  href?: string;
  type?: 'button' | 'submit';
  rel?: string;
  target?: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const { href, type = 'button', rel, target, variant = 'primary', class: classProp = '' } =
  Astro.props;

const baseClass =
  'inline-flex items-center justify-center gap-x-2 rounded-lg px-[calc(--spacing(3)-1px)] py-[calc(--spacing(2)-1px)] text-sm font-semibold transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';

const primaryClass =
  'relative isolate border border-transparent bg-(--btn-border) text-white before:absolute before:inset-0 before:-z-10 before:rounded-[calc(var(--radius-lg)-1px)] before:bg-(--btn-bg) before:shadow-sm after:absolute after:inset-0 after:-z-10 after:rounded-[calc(var(--radius-lg)-1px)] after:shadow-[inset_0_1px_--theme(--color-white/15%)] active:after:bg-(--btn-hover-overlay)/30 hover:after:bg-(--btn-hover-overlay)/15 [--btn-bg:var(--color-accent)] [--btn-border:var(--color-sky-500)] [--btn-hover-overlay:var(--color-sky-600)]';

const secondaryClass =
  'border border-border bg-transparent text-foreground hover:bg-black/5';

const className = `${baseClass} ${variant === 'secondary' ? secondaryClass : primaryClass} ${classProp}`;
---

{
	href ? (
		<a href={href} rel={rel} target={target} class={`${className} cursor-pointer`}>
			<slot />
		</a>
	) : (
		<button type={type} class={`${className} cursor-default`}>
			<slot />
		</button>
	)
}
